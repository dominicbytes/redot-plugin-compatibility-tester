# syntax=docker/dockerfile:1.7
FROM python:3.14.8-slim-bookworm@sha256:48b13b003dda20b16f9442b8475aa05fe21bf6579a8c881db92ffb4d8fd20f83 AS engine-download

ARG REDOT_VERSION=26.3-stable
ARG REDOT_SHA512=d370f50a85efa1c62549743c9c55f56fdac3f4ea66f353bfa3135d4c4fe68ef47849db7ce5d37b6ab9b09c5aa6ee748e10f44dc2c55485f3e799f5dfe2344166

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl unzip; \
    rm -rf /var/lib/apt/lists/*; \
    echo "$REDOT_SHA512" | grep -Eq '^[a-f0-9]{128}$'; \
    curl --fail --location --proto '=https' --tlsv1.2 \
      "https://github.com/Redot-Engine/redot-engine/releases/download/redot-${REDOT_VERSION}/Redot_v${REDOT_VERSION}_linux_x64.zip" \
      --output /tmp/redot.zip; \
    echo "$REDOT_SHA512  /tmp/redot.zip" | sha512sum -c -; \
    test "$(unzip -Z1 /tmp/redot.zip | grep -Fxc 'redot.linuxbsd.editor.x86_64')" -eq 1; \
    mkdir -p /opt/redot; \
    unzip -p /tmp/redot.zip redot.linuxbsd.editor.x86_64 > /opt/redot/redot; \
    chmod 0555 /opt/redot/redot; \
    cd /opt/redot; \
    sha256sum redot > SHA256SUMS

FROM python:3.14.8-slim-bookworm@sha256:48b13b003dda20b16f9442b8475aa05fe21bf6579a8c881db92ffb4d8fd20f83

LABEL org.opencontainers.image.title="redot-compat worker" \
      org.opencontainers.image.source="https://github.com/dominicbytes/redot-plugin-compatibility-tester" \
      org.opencontainers.image.licenses="MIT"

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates xvfb \
      libasound2 libfontconfig1 libgl1 libxi6 libxinerama1 libxcursor1 libx11-6; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --gid 10001 worker; \
    useradd --uid 10001 --gid 10001 --no-create-home --home-dir /home/worker worker

COPY --from=engine-download /opt/redot /opt/redot
RUN cd /opt/redot && sha256sum --check --strict SHA256SUMS

COPY docker/requirements.lock /opt/redot-compat/requirements.lock
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore
RUN python -m pip install --no-cache-dir --require-hashes \
      --requirement /opt/redot-compat/requirements.lock

COPY src /opt/redot-compat/src
COPY harness /opt/redot-compat/harness
COPY LICENSE /opt/redot-compat/LICENSE

ENV HOME=/home/worker \
    PYTHONPATH=/opt/redot-compat/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER 10001:10001
WORKDIR /opt/redot-compat
ENTRYPOINT ["python", "-m", "redot_compat.worker"]
