{
  "$defs": {
    "BatchItem": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "plugin_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plugin Id"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release"
        },
        "source": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source"
      ],
      "title": "BatchItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "concurrency": {
      "default": 2,
      "maximum": 8,
      "minimum": 1,
      "title": "Concurrency",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/BatchItem"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "items"
  ],
  "title": "BatchManifest",
  "type": "object"
}
